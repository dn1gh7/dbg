{
  "name": "dbg",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "cms": "docker compose --env-file .env.docker up",
    "cms:down": "docker compose --env-file .env.docker down",
    "cms:logs": "docker compose --env-file .env.docker logs -f strapi",
    "cms:seed": "docker compose --env-file .env.docker exec strapi npm run seed",
    "prod:up": "docker compose -f docker-compose.prod.yaml --env-file .env.docker up --build -d",
    "prod:down": "docker compose -f docker-compose.prod.yaml --env-file .env.docker down"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "lucide-react": "^0.537.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.2.0",
    "swiper": "^11.2.5",
    "tailwindcss": "^4.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "prettier": "3.5.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.1.0"
  }
}
