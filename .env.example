# Every environment variable this project reads, in one place.
#
# This file is a reference, not something you copy wholesale — each section below says
# which file it belongs in. Two real files exist; both are gitignored:
#
#   .env.development.local   section 1   — read by Vite during `npm run dev`
#   .env.docker              section 2   — read by `docker compose --env-file .env.docker`
#
# They stay separate on purpose. Vite and Docker Compose both read dotenv files, and
# Vite inlines every VITE_-prefixed variable into a bundle the browser downloads. A
# single shared `.env` would put the Strapi secrets in Vite's scope — and Compose
# auto-loads `.env` too, so the collision goes both ways.


# =============================================================================
# 1. FRONTEND  →  .env.development.local
# =============================================================================
# Vite inlines these at BUILD time. They are baked into the bundle, so treat every
# value here as public and never put a write-capable token in it.
#
# Deliberately NOT `.env.local`: Vite loads `.env.local` in production builds too,
# which is how `http://localhost:1337` once ended up in a deployed bundle. The
# `.development.` variant only applies to `npm run dev`.
#
# Leave VITE_STRAPI_URL unset to run the site on its built-in static content.

# Strapi from docker-compose.yaml, published on the host:
VITE_STRAPI_URL=http://localhost:1337

# Or via the Vite dev proxy (see vite.config.ts) — avoids configuring Strapi CORS:
# VITE_STRAPI_URL=http://localhost:8080/strapi-api

# Optional, only if the API is not publicly readable:
# VITE_STRAPI_API_TOKEN=

# In production VITE_STRAPI_URL is a Docker build arg, not a file — see section 2.


# =============================================================================
# 2. DOCKER COMPOSE  →  .env.docker
# =============================================================================
#   docker compose --env-file .env.docker up --build                    (dev)
#   docker compose -f docker-compose.prod.yaml --env-file .env.docker up -d
#
# Replace every secret with a long random string:  openssl rand -base64 32
# Generate them once and keep them somewhere safe — changing STRAPI_ENCRYPTION_KEY
# later makes existing encrypted values unreadable.
#
# The compose files map these onto Strapi's own names (STRAPI_APP_KEYS → APP_KEYS).

# Comma-separated list — Strapi reads it with env.array(), see cms/config/server.ts.
STRAPI_APP_KEYS=replaceMe1,replaceMe2
STRAPI_API_TOKEN_SALT=replaceMe
STRAPI_ADMIN_JWT_SECRET=replaceMe
STRAPI_TRANSFER_TOKEN_SALT=replaceMe
STRAPI_JWT_SECRET=replaceMe
# Required by Strapi 5 — it will not boot without this one.
STRAPI_ENCRYPTION_KEY=replaceMe

# Public origin Strapi is reached at. Uploaded media URLs are built from this, so it
# must be what the *browser* sees, not the internal container address.
STRAPI_PUBLIC_URL=http://localhost:1337

# Comma-separated origins allowed to call the API (the site's origin, not the CMS's).
STRAPI_CORS_ORIGINS=http://localhost:8080

# Baked into the frontend bundle as a build arg by docker-compose.prod.yaml. Changing
# it needs an image rebuild — restarting the container will not pick it up.
VITE_STRAPI_URL=http://localhost:1337

# Postgres. docker-compose.prod.yaml uses these; the dev stack hardcodes strapi/strapi.
POSTGRES_USER=strapi
POSTGRES_PASSWORD=replaceMe
POSTGRES_DB=strapi


# =============================================================================
# 3. STRAPI WITHOUT DOCKER  →  cms/.env
# =============================================================================
# Only needed if you run `cd cms && npm run develop` directly on the host. The Docker
# stacks inject these themselves (from section 2), so you can ignore this otherwise.
# Note the unprefixed names — this is what Strapi actually reads.
#
# HOST=0.0.0.0
# PORT=1337
# APP_KEYS=replaceMe1,replaceMe2
# API_TOKEN_SALT=replaceMe
# ADMIN_JWT_SECRET=replaceMe
# TRANSFER_TOKEN_SALT=replaceMe
# JWT_SECRET=replaceMe
# ENCRYPTION_KEY=replaceMe
# STRAPI_PUBLIC_URL=http://localhost:1337
# STRAPI_CORS_ORIGINS=http://localhost:8080
#
# Without DATABASE_CLIENT set, config/database.ts falls back to SQLite in cms/.tmp,
# which is the quickest way to poke at a schema change without starting Postgres.
