{
  "description": "Reference for the Strapi content types this site consumes. The authoritative definitions live in cms/src/api/*/content-types/*/schema.json and cms/src/components/shared/link-row.json — this file mirrors them for quick lookup. Field names must stay in sync with src/lib/strapi/mappers.ts and src/lib/strapi/events.ts.",
  "types": [
    {
      "apiId": "event",
      "displayName": "Event",
      "fields": [
        { "name": "title", "type": "string", "required": true },
        { "name": "description", "type": "blocks" },
        { "name": "startDate", "type": "date" },
        { "name": "endDate", "type": "date" },
        { "name": "cardImage", "type": "media (single, images)" },
        { "name": "images", "type": "media (multiple, images)" },
        { "name": "invitePdf", "type": "media (single, files)" },
        { "name": "programPdf", "type": "media (single, files)" }
      ],
      "permissions": "Public: find, findOne",
      "note": "startDate/endDate are date (not datetime). src/lib/strapi/events.ts parses YYYY-MM-DD as local midnight so an event dated today is not pushed into the archive."
    },
    {
      "apiId": "presidium-member",
      "displayName": "Presidium-Member",
      "fields": [
        { "name": "name", "type": "string", "required": true },
        { "name": "roleTitle", "type": "string" },
        { "name": "sortOrder", "type": "integer", "default": 0 }
      ],
      "permissions": "Public: find"
    },
    {
      "apiId": "publication",
      "displayName": "Publication",
      "fields": [
        { "name": "title", "type": "string", "required": true },
        { "name": "description", "type": "text" },
        {
          "name": "category",
          "type": "enumeration",
          "values": ["bulgarica", "bibliothek", "forum"]
        },
        { "name": "sortOrder", "type": "integer", "default": 0 },
        { "name": "coverImage", "type": "media (single, images)" },
        { "name": "pdfVerzeichnis", "type": "media (single, files)" },
        { "name": "pdfInfo", "type": "media (single, files)" },
        {
          "name": "pdfExternal",
          "type": "string",
          "note": "External URL (e.g. a journal article)"
        },
        { "name": "showOnHome", "type": "boolean", "default": false },
        { "name": "homeOrder", "type": "integer", "default": 0 }
      ],
      "permissions": "Public: find",
      "note": "The category values are the exact strings src/lib/strapi/queries.ts filters on. Media fields are single, not multiple — mediaUrl() in src/lib/strapi/media.ts does not resolve arrays."
    },
    {
      "apiId": "link-section",
      "displayName": "Link-Section",
      "fields": [
        { "name": "title", "type": "string", "required": true },
        { "name": "sortOrder", "type": "integer", "default": 0 },
        {
          "name": "rows",
          "type": "component (repeatable)",
          "component": {
            "uid": "shared.link-row",
            "fields": [
              { "name": "text", "type": "string", "required": true },
              { "name": "url", "type": "string", "required": true }
            ]
          }
        }
      ],
      "permissions": "Public: find",
      "note": "Queried with populate[rows]=* — populate=* does not reach into components."
    }
  ]
}
