{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Beiträge",
    "description": "A contribution. Title and preview image are fixed; everything the page shows lives in the editor-ordered blocks of `body`."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "sortOrder": {
      "type": "integer"
    },
    "cardImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "body": {
      "type": "dynamiczone",
      "components": [
        "content.rich-text",
        "content.image",
        "content.gallery",
        "content.button-row"
      ]
    }
  }
}
