{
  "kind": "collectionType",
  "collectionName": "publications",
  "info": {
    "singularName": "publication",
    "pluralName": "publications",
    "displayName": "Publication"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "bulgarica",
        "bibliothek",
        "forum"
      ]
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "pdfVerzeichnis": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files"
      ]
    },
    "pdfInfo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files"
      ]
    },
    "pdfExternal": {
      "type": "string"
    },
    "showOnHome": {
      "type": "boolean",
      "default": false
    },
    "homeOrder": {
      "type": "integer",
      "default": 0
    }
  }
}
